# Public browser configuration (Supabase Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# SERVER ONLY: keep these in Vercel Environment Variables, never use NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOT_TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_RANDOM_BYTES

# Enable only after Telegram OIDC is configured and tested in Supabase.
# This is a PUBLIC feature flag, not a credential. No bot/API/OIDC secret goes into this variable.
NEXT_PUBLIC_TELEGRAM_LOGIN_ENABLED=false
